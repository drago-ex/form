{define password-toggle, string $name, int $columns = 12, ?string $class = null}
	<div class="col-md-{$columns} form-error">
		{label $name, class => "form-label fw-semibold" /}
		<div class="password-toggle-wrapper">
			{input $name, class => ['form-control input-password', $class]}

			<button type="button" class="d-none toggle-password"></button>
		</div>
	</div>
{/define}
