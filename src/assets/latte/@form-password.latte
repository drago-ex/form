{* a password input with a button that shows the password (module password-toggle of compostrap) *}
{define password-toggle, string $name, int $columns = 12, ?string $class = null}
	<div class="col-md-{$columns} form-error">
		{label $name, class => "form-label fw-semibold" /}
		<div class="password-toggle">
			{input $name, class => ['form-control', $class]}
			<button type="button" class="password-toggle-btn" data-password-toggle aria-label="{_'Show password'}" aria-pressed="false"></button>
		</div>
	</div>
{/define}
