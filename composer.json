{
	"name": "drago-ex/form",
	"description": "Helper classes for Nette forms with extended inputs and shortcuts.",
	"type": "library",
	"license": ["MIT"],
	"authors": [
		{
			"name": "Zdeněk Papučík",
			"homepage": "https://github.com/accgit"
		}
	],
	"require": {
		"php": ">=8.3 <9",
		"nette/application": "^3.1",
		"nette/forms": "^3.0",
		"latte/latte": "^3.0"
	},
	"suggest": {
		"drago-ex/translator": "Configures Latte translation support for bundled templates using translation macros."
	},
	"require-dev": {
		"nette/tester": "^2.3",
		"tracy/tracy": "^2.7",
		"phpstan/phpstan-nette": "^2.0"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Drago\\": "src"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"src/Drago/assets/latte": "app/Presentation/Accessory/Widget"
				}
			}
		},
		"drago-translator": {
			"translation": "src/Form/Translate"
		}
	}
}
